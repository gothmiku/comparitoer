{
  "name": "comparitoer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Comparitoer — client-side video comparison: duration check, wipe divider, and synced playback. No backend, no uploads.",
  "scripts": {
    "dev": "npm run core:copy && vite",
    "build": "npm run core:copy && vite build",
    "core:copy": "node scripts/copy-ffmpeg-core.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15"
  }
}
